[version]
signature="$CHICAGO$"
Class=Ports
ClassGuid={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%PRO%
DriverVer=01/21/2026,5.1.11.0
PnpLockdown=1
CatalogFile=plser.cat

; ================= Device Install section =====================

[ControlFlags]
ExcludeFromSelect=*

[Manufacturer]
%PRO%=PRO,NTx86,NTAMD64

[SourceDisksFiles]
plser.sys=1
plser64.sys=1
plser.dll=1
plser64.dll=1

[SourceDisksNames]
1=%DISK_NAME%,

[DestinationDirs] 
DefaultDestDir  = 12
CopyFilesx86 = 11
CopyFilesx64 = 11

[PRO.NTx86]
%DeviceDesc1% = ComPort, USB\VID_067B&PID_23B3
%DeviceDesc2% = ComPort, USB\VID_067B&PID_23C3
%DeviceDesc3% = ComPort, USB\VID_067B&PID_23D3
%DeviceDesc4% = ComPort, USB\VID_067B&PID_23E3
