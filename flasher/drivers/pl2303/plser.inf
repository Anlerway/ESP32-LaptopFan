[ComPort.NTx86]
CopyFiles=ComPort.NTx86.Copy
CopyFiles=CopyFilesx86
AddReg=ComPort.NTx86.AddReg

[ComPort.NTx86.HW]
AddReg=ComPort.HW.AddReg

[ComPort.NTx86.Services]
AddService = plserx86, 0x00000002, Serial_Service_Inst.NTx86

[ComPort.NTx86.Copy]
plser.sys

[CopyFilesx86]
plser.dll

[ComPort.NTx86.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,plser.sys
HKR,,EnumPropPages32,,"plser.dll,SerialPortPropPageProvider"
HKR,,PortSubClass,1,01

[ComPort.HW.AddReg]
HKR,,"UpperFilters",0x00010000,"serenum"
HKR,,"PL2303C1",0x00010001,10
HKR,,"PL2303C2",0x00010001,0
HKR,,"PL2303C3",0x00010001,4096

[ComPort.NTAMD64]
CopyFiles=ComPort.NTAMD64.Copy
CopyFiles=CopyFilesx64
AddReg=ComPort.NTAMD64.AddReg

[ComPort.NTAMD64.HW]
AddReg=ComPort.HW.AddReg

[ComPort.NTAMD64.Services]
AddService = plser, 0x00000002, Serial_Service_Inst.NTAMD64

[ComPort.NTAMD64.Copy]
plser64.sys

[CopyFilesx64]
plser64.dll

[ComPort.NTAMD64.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,plser64.sys
HKR,,NTMPDriver,,serenum.sys
HKR,,EnumPropPages32,,"plser64.dll,SerialPortPropPageProvider"
HKR,,PortSubClass,1,01

[Serial_Service_Inst.NTx86]
DisplayName    = %Serial.SVCDESC%                            
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\plser.sys                            
LoadOrderGroup = Base

[Serial_Service_Inst.NTAMD64]
DisplayName    = %Serial.SVCDESC%                            
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\plser64.sys                            
LoadOrderGroup = Base


